+#ifdef S60V3
+// CPyMO's logical canvas is always landscape. ESX0Portrait is SDL's
+// unrotated/native mapping flag, so E63-like landscape screens NEED the bit,
+// while portrait-shaped physical screens must use the rotated mapping.
+// The saved ScreenMode must never choose the game's orientation.
+TInt CPyMOLandscapeScreenMode(TInt aMode, const TSize& aPhysicalSize)
+{
+	aMode &= ~ESX0Portrait;
+	if (aPhysicalSize.iWidth > aPhysicalSize.iHeight)
+		aMode |= ESX0Portrait;
+	// SDL also treats mode 0 as unrotated/native. Prevent that escape route.
+	if (aMode == 0)
+		aMode = ESX0Stretched | ESX0Flipped;
+	return aMode;
+}
+#endif
