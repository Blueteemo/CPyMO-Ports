 void CEBasicAppUi::HandleWsEventL(const TWsEvent& aEvent, CCoeControl* aDestination)
 {
 	TInt type= aEvent.Type();
+#ifdef S60V3
+	const bool movie_active = cpymo_s60_movie_active();
+	if (movie_active && type == KAknUidValueEndKeyCloseEvent)
+		return;
+	// The player can return CPyMO to the foreground before its closing key lifts.
+	static TInt movie_keys_down = 0;
+	if (movie_active && type == EEventFocusLost)
+		movie_keys_down = 3;
+	if (type == EEventKey || type == EEventKeyDown || type == EEventKeyUp)
+	{
+		const TInt scan = aEvent.Key()->iScanCode;
+		const TInt bit = scan == EStdKeyDevice1 ? 1 : scan == EStdKeyNo ? 2 : 0;
+		if (bit)
+		{
+			if (type == EEventKeyDown)
+			{
+				movie_keys_down &= ~bit;
+				if (movie_active) movie_keys_down |= bit;
+			}
+			const bool consumed = movie_active || (movie_keys_down & bit);
+			if (type == EEventKeyUp) movie_keys_down &= ~bit;
+			if (consumed) return;
+		}
+	}
+	// Deliver native query input to Avkon. A softkey can close the dialog
+	// before its release reaches the app UI.
+	static TInt native_softkeys_down = 0;
+	if (type == EEventKeyDown || type == EEventKeyUp)
+	{
+		const TInt scan = aEvent.Key()->iScanCode;
+		const TInt bit = scan == EStdKeyDevice0 ? 1 : scan == EStdKeyDevice1 ? 2 : 0;
+		if (type == EEventKeyDown)
+		{
+			native_softkeys_down &= ~bit;
+			if (cpymo_s60_native_query_open()) native_softkeys_down |= bit;
+		}
+		else if (native_softkeys_down & bit)
+		{
+			native_softkeys_down &= ~bit;
+			if (!cpymo_s60_native_query_open()) return;
+		}
+	}
+	if (cpymo_s60_native_query_open())
+	{
+		CEikAppUi::HandleWsEventL(aEvent, aDestination);
+		return;
+	}
+	// Handle both Avkon's close event and the raw red key before focus can move.
+	if (current_video &&
+	    (type == KAknUidValueEndKeyCloseEvent ||
+	     (type == EEventKeyDown && aEvent.Key()->iScanCode == EStdKeyNo)) &&
+	    cpymo_s60_handle_selector_end_key())
+		return;
+	// The E63 prints 0 on M. Accept that scancode only in the selector.
+	if (current_video && (type == EEventKeyDown || type == EEventKeyUp))
+	{
+		const TInt scan = aEvent.Key()->iScanCode;
+		const TBool letter_zero = (scan == 'M' || scan == 'm') && cpymo_s60_selector_mode();
+		if (scan == '0' || scan == EStdKeyNkp0 || scan == EStdKeyDevice1 || letter_zero)
+		{
+			SDL_keysym key;
+			key.scancode = scan;
+			key.sym = scan == EStdKeyDevice1 ? SDLK_ESCAPE : letter_zero ? SDLK_m : SDLK_0;
+			key.mod = KMOD_NONE;
+			key.unicode = 0;
+			SDL_PrivateKeyboard(type == EEventKeyDown ? SDL_PRESSED : SDL_RELEASED, &key);
+			return;
+		}
+	}
+	// On full keyboards, a Fn-modified key may report 0 only as a character.
+	if (current_video && type == EEventKey && aEvent.Key()->iCode == '0' &&
+		!aEvent.Key()->iRepeats && aEvent.Key()->iScanCode != '0' &&
+		aEvent.Key()->iScanCode != EStdKeyNkp0)
+	{
+		SDL_Event key;
+		SDL_memset(&key, 0, sizeof(key));
+		key.key.type = SDL_KEYDOWN;
+		key.key.state = SDL_PRESSED;
+		key.key.keysym.sym = SDLK_0;
+		SDL_PushEvent(&key);
+		return;
+	}
+#endif
 #ifdef UIQ3
 	CQikAppUi::HandleWsEventL(aEvent,aDestination);
 #else
