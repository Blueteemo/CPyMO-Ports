+	iMultitapTimer = CPeriodic::NewL(CActive::EPriorityStandard);
+	TCallBack start(StaticSDLStartL,this);
+	iSDLstart.Set(start);
+	iSDLstart.CallBack();
+	atexit(&symbian_at_exit);
+}
