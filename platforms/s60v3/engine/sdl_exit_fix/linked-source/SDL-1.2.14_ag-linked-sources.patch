-/** !!
-*/
-TInt TKeyMapItem::Compare(const TKeyMapItem& aFirst, const TKeyMapItem& aSecond)
-	{
-	if (aFirst.iOldCode < aSecond.iOldCode)
-		return -1;
-	if (aFirst.iOldCode > aSecond.iOldCode)
-		return 1;
-	// Scancodes are equal, compare flags
-	if (aFirst.iOldFlag < aSecond.iOldFlag)
-		return -1;
-	if (aFirst.iOldFlag > aSecond.iOldFlag)
-		return 1;
-	return 0;
-	}
