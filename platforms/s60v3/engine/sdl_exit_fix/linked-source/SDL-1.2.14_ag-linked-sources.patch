+void CEBasicAppUi::HandleForegroundEventL(TBool aForeground)
+{
+	iView->iForeground=aForeground;
+#ifdef S60V3
+	if (!aForeground && cpymo_s60_movie_active())
+	{
+		cpymo_s60_movie_note_background();
+		SDL_ResetKeyboard();
+		SDL_Event released;
+		while (SDL_PeepEvents(&released, 1, SDL_GETEVENT, SDL_EVENTMASK(SDL_KEYUP)) > 0) {}
+	}
+#endif
+#if defined (S60) || defined (S60V3)
+	CAknAppUi::HandleForegroundEventL(aForeground);
+	
+	if(aForeground)
+	{
+		SetKeyBlockMode(ENoKeyBlock);
+		iEikonEnv->VirtualCursor().SetCursorStateL( TEikVirtualCursor::EOn,
+		                                                *iEikonEnv);
+		iEikonEnv->WsSession().SetPointerCursorMode( EPointerCursorNormal );
+	}
+	else
+	{
+		iEikonEnv->VirtualCursor().SetCursorStateL( TEikVirtualCursor::EOff,
+			                                                *iEikonEnv);
+		iEikonEnv->WsSession().SetPointerCursorMode( EPointerCursorNone );
+	}
+#elif defined(UIQ)
+	CQikAppUi::HandleForegroundEventL(aForeground);
+	if(aForeground)
+	{
+		CaptureKeysL();
+	}
+	else
+	{
+		CancelCaptureKeys();
+	}
+#elif defined (UIQ3)
+	CQikAppUi::HandleForegroundEventL(aForeground);
+#else
+	CEikAppUi::HandleForegroundEventL(aForeground);
+#endif
+
+#if !defined(UIQ)	
+	if(!aForeground)
+	{
+		iView->AbortNow(RDirectScreenAccess::ETerminateCancel);
+		gViewVisible=false;
+	}
+	else
+	{
+#ifdef S60V3
+		// A camera, phone call or native media player can change the physical
+		// screen while CPyMO is backgrounded. Do not trust a stale SDL mode.
+		const bool videoReady = current_video && current_video->hidden && current_video->screen;
+		bool displayChanged = false;
+		if (videoReady)
+		{
+			SDL_PrivateVideoData* priv = current_video->hidden;
+			const TSize physical = iEikonEnv->ScreenDevice()->SizeInPixels();
+			const bool geometryChanged = (priv->EPOC_ScreenSize != physical);
+			const TInt mode = CPyMOLandscapeScreenMode(priv->iSX0Mode, physical);
+			displayChanged = geometryChanged || mode != priv->iSX0Mode;
+			priv->iSX0Mode = mode;
+			if (geometryChanged)
+			{
+				iView->SetRect(TRect(TPoint(0,0), physical));
+				EPOC_ReconfigureVideo(current_video);
+			}
+		}
+#endif
+		iView->Restart(RDirectScreenAccess::ETerminateCancel);
+		gViewVisible=true;
+#ifdef S60V3
+		if (videoReady)
+		{
+			// Restart does not restore the clipping region by itself.
+			if (displayChanged)
+				UpdateAndRedrawScreenL();
+			else
+				iView->UpdateClipRect();
+			current_video->hidden->iNeedFullRedraw = ETrue;
+		}
+#endif
+	}
+#endif
+
+	SDL_PauseAudio(!aForeground);
+}
